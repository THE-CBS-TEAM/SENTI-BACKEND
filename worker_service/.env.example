# Worker Service Environment Configuration

# Authentication Key for API Clients (Sentimentri Core & External Platforms)
WORKER_API_KEY=replace-with-a-long-random-secret

# Standalone Database (PostgreSQL recommended in Dokploy/Production)
DATABASE_URL=postgresql://worker_user:replace-me@localhost:5432/worker_db

# Redis Broker for Celery Queue
REDIS_URL=redis://redis:6379/0

# External API Integrations
APIFY_TOKEN=replace-with-your-apify-token
SOCIALDATA_API_KEY=replace-with-your-socialdata-api-key
DEEP_SEEK_SECRET=replace-with-your-deepseek-api-secret

# Object Storage for Generated PDF Reports & Avatars (S3 / Cloudflare R2 / MinIO)
S3_ENABLED=false
S3_BUCKET_NAME=sentimentri-reports
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT_URL=
S3_REGION=auto

# Webhook Callback Verification Secret
WEBHOOK_SECRET=replace-with-your-webhook-signing-secret
