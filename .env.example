# Django configuration
SECRET_KEY=replace-with-a-long-random-django-secret
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# Database and task queue
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/DATABASE
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Third-party integrations
APIFY_API_TOKEN=replace-with-your-apify-token
SOCIALDATA_API_KEY=replace-with-your-socialdata-api-key

# Admin registration keys
SUPER_ADMIN_ACCESS_KEY=replace-with-a-unique-secret
DEVELOPER_ACCESS_KEY=replace-with-a-unique-secret
SUPPORT_ACCESS_KEY=replace-with-a-unique-secret
WEBHOOK_SECRET=replace-with-a-unique-random-secret
